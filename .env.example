PORT=3000
DATABASE_URL=postgres://webapp:webapp_password@localhost:5432/webapp
SESSION_SECRET=replace-this-with-a-long-random-string
SESSION_TTL_MS=86400000
# Bật khi app chạy sau Kubernetes Ingress/reverse proxy dùng HTTPS.
TRUST_PROXY=true
COOKIE_SECURE=true
MAX_ACCOUNTS=5
MAX_FILE_SIZE_MB=30
DB_POOL_MAX=5
DB_STATEMENT_TIMEOUT_MS=120000
MAX_CONCURRENT_UPLOADS=1
MAX_CONCURRENT_DOWNLOADS=2

# Dùng với docker-compose.external-db.yml
DB_HOST=192.168.2.90
DB_PORT=5432
DB_NAME=webapp
DB_USER=webapp
DB_PASSWORD=replace-with-your-database-password
