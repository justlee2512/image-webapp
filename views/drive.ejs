<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title><%= currentFolder ? currentFolder.name : 'Thư viện ảnh' %> · Image Drive</title>
  <link rel="stylesheet" href="/assets/styles.css?v=<%= assetVersion %>">
</head>
<body data-folder-id="<%= currentFolder ? currentFolder.id : '' %>" data-max-file-size-mb="<%= maxFileSizeMb %>">
  <header class="topbar">
    <a class="wordmark" href="/drive"><span class="brand-mark brand-mark-small">RL</span><span>Image Drive</span></a>
    <nav class="top-actions">
      <% if (isAdmin) { %><a class="button button-ghost" href="/admin/users">Quản lý tài khoản</a><% } %>
      <span class="user-chip"><span class="avatar"><%= user.username.charAt(0).toUpperCase() %></span><span><strong><%= user.username %></strong><small><%= isAdmin ? 'Administrator' : 'Member' %></small></span></span>
      <form method="post" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="button button-ghost" type="submit">Đăng xuất</button>
      </form>
    </nav>
  </header>

  <main class="page-shell drive-shell">
    <div class="breadcrumbs">
      <a href="/drive">Thư viện</a>
      <% if (currentFolder) { %><span>/</span><span><%= currentFolder.name %></span><% } %>
    </div>

    <div class="page-heading drive-heading">
      <div>
        <p class="eyebrow"><%= currentFolder ? (isOwner ? 'FOLDER CỦA BẠN' : `ĐƯỢC CHIA SẺ BỞI ${currentFolder.owner_name}`) : 'THƯ VIỆN CÁ NHÂN' %></p>
        <h1><%= currentFolder ? currentFolder.name : 'Ảnh của bạn' %></h1>
        <p class="muted"><%= images.length %> ảnh · <%= folders.length %> folder có thể truy cập</p>
      </div>
      <div class="heading-actions">
        <label class="search-box"><span aria-hidden="true">⌕</span><input type="search" placeholder="Tìm ảnh hoặc folder…" data-search></label>
        <% if (!currentFolder || isOwner) { %><button class="button button-primary" type="button" data-open-upload>Tải ảnh lên</button><% } %>
      </div>
    </div>

    <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>
    <% if (success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
    <div class="alert alert-hidden" data-live-alert role="status"></div>

    <% if (!currentFolder) { %>
      <section class="section-block" data-search-section>
        <div class="section-heading">
          <div><h2>Folder</h2><p class="muted">Sắp xếp ảnh hoặc chia sẻ một folder chỉ đọc.</p></div>
          <details class="popover-details">
            <summary class="button button-secondary">Folder mới</summary>
            <form method="post" action="/folders" class="popover-card stack-form" data-ajax-form>
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <label><span>Tên folder</span><input name="name" required maxlength="100" autofocus></label>
              <button class="button button-primary" type="submit">Tạo folder</button>
            </form>
          </details>
        </div>
        <div class="folder-grid">
          <% folders.forEach((folder) => { %>
            <article class="folder-card" data-search-item="<%= folder.name.toLowerCase() %> <%= folder.owner_name.toLowerCase() %>">
              <a class="folder-main" href="/drive?folder=<%= encodeURIComponent(folder.id) %>">
                <span class="folder-icon" aria-hidden="true">▰</span>
                <span><strong><%= folder.name %></strong><small><%= folder.image_count %> ảnh · <%= folder.is_owner ? 'Của bạn' : `Bởi ${folder.owner_name}` %></small></span>
              </a>
              <% if (folder.is_owner || isAdmin) { %>
                <form method="post" action="/folders/<%= folder.id %>/delete" data-confirm="Xóa folder này và toàn bộ ảnh bên trong?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="icon-button danger-text" type="submit" aria-label="Xóa folder">×</button>
                </form>
              <% } %>
            </article>
          <% }) %>
          <% if (!folders.length) { %><div class="empty-inline">Chưa có folder nào. Hãy tạo folder đầu tiên.</div><% } %>
        </div>
      </section>
    <% } %>

    <% if (currentFolder && isOwner) { %>
      <section class="share-panel">
        <div><h2>Chia sẻ folder</h2><p class="muted">Người được chia sẻ có thể xem và tải ảnh, nhưng không thể sửa hoặc xóa.</p></div>
        <form method="post" action="/folders/<%= currentFolder.id %>/share" class="inline-form" data-ajax-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input name="identity" placeholder="Tên tài khoản hoặc email" required maxlength="255">
          <button class="button button-secondary" type="submit">Chia sẻ</button>
        </form>
        <% if (sharedUsers.length) { %>
          <div class="shared-list">
            <% sharedUsers.forEach((shared) => { %>
              <span class="shared-chip"><span><strong><%= shared.username %></strong><small><%= shared.email %></small></span>
                <form method="post" action="/folders/<%= currentFolder.id %>/unshare">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="userId" value="<%= shared.id %>">
                  <button class="icon-button" type="submit" aria-label="Thu hồi quyền của <%= shared.username %>">×</button>
                </form>
              </span>
            <% }) %>
          </div>
        <% } %>
      </section>
    <% } %>

    <section class="section-block image-section" data-search-section>
      <div class="section-heading sticky-selection-heading">
        <div><h2>Ảnh</h2><p class="muted">Nhấp vào ảnh để xem lớn. Có thể chọn nhiều ảnh để tải, di chuyển hoặc xóa.</p></div>
        <div class="selection-toolbar" data-selection-toolbar hidden>
          <strong><span data-selected-count>0</span> đã chọn</strong>
          <button class="button button-small button-ghost" type="button" data-select-all>Chọn tất cả</button>
          <select class="compact-select" data-move-target aria-label="Folder đích">
            <option value="">Thư mục gốc</option>
            <% folders.filter((folder) => folder.is_owner || isAdmin).forEach((folder) => { %>
              <option value="<%= folder.id %>" <%= currentFolder && folder.id === currentFolder.id ? 'disabled' : '' %>><%= folder.name %></option>
            <% }) %>
          </select>
          <button class="button button-small button-secondary" type="button" data-move-selected>Di chuyển</button>
          <button class="button button-small button-secondary" type="button" data-download-selected>Tải ZIP</button>
          <button class="button button-small button-danger" type="button" data-delete-selected>Xóa</button>
        </div>
      </div>

      <div class="image-grid" data-image-grid>
        <% images.forEach((image) => { %>
          <article class="image-card" data-image-id="<%= image.id %>" data-search-item="<%= image.original_name.toLowerCase() %>">
            <div class="image-check"><input type="checkbox" value="<%= image.id %>" data-image-select aria-label="Chọn <%= image.original_name %>"></div>
            <button class="image-preview" type="button" data-lightbox-src="/images/<%= image.id %>" data-lightbox-name="<%= image.original_name %>" aria-label="Xem <%= image.original_name %>">
              <img src="/images/<%= image.id %>/thumbnail" alt="<%= image.original_name %>" loading="lazy" decoding="async" width="520" height="390">
            </button>
            <div class="image-meta">
              <div class="image-title"><strong title="<%= image.original_name %>"><%= image.original_name %></strong><small><%= (image.size_bytes / 1024 / 1024).toFixed(2) %> MB<% if (image.width && image.height) { %> · <%= image.width %>×<%= image.height %><% } %></small></div>
              <div class="image-actions">
                <a class="icon-button" href="/images/<%= image.id %>/download" aria-label="Tải xuống" title="Tải xuống">↓</a>
                <% if (String(image.user_id) === String(user.id) || isAdmin) { %>
                  <form method="post" action="/images/<%= image.id %>/delete" data-confirm="Xóa ảnh này?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="icon-button danger-text" type="submit" aria-label="Xóa ảnh" title="Xóa">×</button>
                  </form>
                <% } %>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <% if (!images.length) { %>
        <div class="empty-state" data-empty-state>
          <div class="empty-icon" aria-hidden="true">▧</div>
          <h3>Chưa có ảnh trong thư mục này</h3>
          <p><%= (!currentFolder || isOwner) ? 'Tải ảnh lên bằng nút phía trên hoặc kéo ảnh vào cửa sổ.' : 'Chủ folder chưa thêm ảnh.' %></p>
        </div>
      <% } %>
    </section>
  </main>

  <% if (!currentFolder || isOwner) { %>
    <dialog class="upload-dialog" data-upload-dialog>
      <form method="dialog"><button class="dialog-close icon-button" aria-label="Đóng">×</button></form>
      <div class="dialog-heading"><p class="eyebrow">UPLOAD</p><h2>Tải ảnh lên</h2><p class="muted">JPG, PNG, GIF hoặc WebP · tối đa <%= maxFileSizeMb %> MB mỗi ảnh.</p></div>
      <div class="drop-zone" data-drop-zone tabindex="0">
        <input type="file" accept="image/jpeg,image/png,image/gif,image/webp" multiple hidden data-file-input>
        <div class="drop-icon" aria-hidden="true">↑</div><strong>Kéo ảnh vào đây</strong><span>hoặc nhấp để chọn nhiều ảnh</span>
      </div>
      <div class="upload-summary" data-upload-summary hidden>
        <div><strong data-upload-file-name>Đang chuẩn bị…</strong><span data-upload-progress-text>0%</span></div>
        <progress max="100" value="0" data-upload-progress></progress>
        <p class="muted" data-upload-status></p>
      </div>
      <div class="dialog-actions"><button class="button button-ghost" type="button" data-cancel-upload>Hủy</button><button class="button button-primary" type="button" data-start-upload disabled>Tải lên</button></div>
    </dialog>
  <% } %>

  <dialog class="lightbox" data-lightbox>
    <form method="dialog"><button class="dialog-close icon-button" aria-label="Đóng">×</button></form>
    <div class="lightbox-stage"><img alt="" data-lightbox-image></div>
    <div class="lightbox-footer"><strong data-lightbox-title></strong><a class="button button-secondary" data-lightbox-download>Tải ảnh</a></div>
  </dialog>

  <script src="/assets/app.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
