<% const isDriveScene = typeof driveScene !== "undefined" && driveScene; %>
<div class="page-scene woodland-scene" aria-hidden="true">
  <div class="scene-dusk"></div>
  <svg class="woodland-art" viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid slice" fill="none">
    <defs>
    <linearGradient id="tree-bark" x1="165" y1="360" x2="295" y2="380" gradientUnits="userSpaceOnUse"><stop stop-color="#645343"/><stop offset=".48" stop-color="#92785a"/><stop offset="1" stop-color="#504736"/></linearGradient>
    <radialGradient id="tree-leaf"><stop stop-color="#8ba47a"/><stop offset="1" stop-color="#476b50"/></radialGradient>
    <linearGradient id="dove-feather" x2="0.5" y2="1"><stop stop-color="#fffdf5"/><stop offset="1" stop-color="#c7cfce"/></linearGradient>
    <linearGradient id="owl-feather" x2="1" y2="1"><stop stop-color="#b87b3b"/><stop offset="1" stop-color="#844719"/></linearGradient>
    <linearGradient id="owl-belly" x2=".6" y2="1"><stop stop-color="#edc68d"/><stop offset="1" stop-color="#cb995f"/></linearGradient>
  
      <radialGradient id="firefly-glow"><stop stop-color="#fffbc0" stop-opacity=".6"/><stop offset=".3" stop-color="#dce897" stop-opacity=".15"/><stop offset="1" stop-color="#dce897" stop-opacity="0"/></radialGradient>
      <radialGradient id="moon-halo"><stop stop-color="#f6eec6" stop-opacity=".12"/><stop offset="1" stop-color="#f6eec6" stop-opacity="0"/></radialGradient>
      <symbol id="woodland-canopy" viewBox="0 0 440 300">
    <!-- Similar-sized leaf clusters form a balanced crown around the trunk. -->
    <path d="M52 218C13 203 7 158 31 130 14 91 44 54 84 57 96 20 142 9 172 33 197 2 247 2 272 33 304 9 349 20 361 57 401 54 431 91 414 130 438 158 432 203 393 218 381 253 340 270 308 251 284 284 246 292 222 273 198 292 160 284 136 251 104 270 64 253 52 218Z" fill="#597d5b"/>
    <path d="M45 151C28 116 54 82 89 83 104 51 144 43 171 66 197 40 238 44 254 76 290 61 325 83 327 118 357 138 353 178 323 197 309 231 267 240 239 217 212 244 173 243 148 219 115 239 75 220 72 190 54 184 43 169 45 151Z" fill="#719069"/>
    <path d="M179 117C168 80 195 52 229 58 252 29 296 38 309 69 345 59 377 84 374 117 404 136 407 176 381 197 383 231 347 255 316 243 289 269 248 259 235 232 199 237 174 209 183 178 167 161 164 134 179 117Z" fill="url(#tree-leaf)"/>
    <path d="M96 210C118 231 145 231 167 218 191 245 219 248 243 232 269 251 300 248 320 228 343 239 364 229 376 215 363 253 334 264 308 251 284 284 246 292 222 273 198 292 160 284 136 251 111 261 83 248 72 225Z" fill="#355c47" opacity=".35"/>
    <path d="M60 125c-2-22 13-35 33-35m20-24c18-10 37-7 48 4m42-35c15-9 31-9 46 0m74 49c22-5 39 9 41 28M193 110c2-19 15-29 32-28m35-17c17-8 33 1 39 14m69 75c15 11 17 25 7 38" stroke="#b1c69b" stroke-opacity=".3" stroke-width="9" stroke-linecap="round"/>
  </symbol>
      <symbol id="woodland-trunk" viewBox="0 0 420 720">
    <!-- A gently tapered trunk keeps the base proportional to the canopy. -->
    <path class="tree-main-trunk" d="M159 720C185 667 188 586 193 510L207 348C187 316 166 286 149 244L162 237C182 271 201 290 218 300L213 171 228 168 244 299C270 277 287 248 301 210L315 216C305 263 284 307 257 344L269 510C274 586 277 667 303 720Z" fill="url(#tree-bark)"/>
    <path d="M220 358C178 332 128 326 81 322L57 307 61 297 90 308C143 308 188 316 226 337Z" fill="#776048"/>
    <path d="M249 395C290 369 331 333 376 313L384 323C339 350 301 392 253 419Z" fill="#776048"/>
    <path d="M187 710C204 630 201 551 215 423m1-39 9-49-3-112M277 710C261 631 260 556 250 459m-5-82 1-34 45-90" stroke="#b59970" stroke-opacity=".35" stroke-width="5" stroke-linecap="round"/>
    <path d="M234 705C226 635 237 578 232 514m7-47-3-60m-19 257 4-61m33 28-5-60" stroke="#473d32" stroke-opacity=".3" stroke-width="4" stroke-linecap="round"/>
    <path d="M129 260C155 269 174 291 191 321L179 321C161 294 149 280 127 270Z" fill="#776048"/>
  </symbol>
    </defs>
    <g class="woodland-stars" fill="#fff3cc">
      <% for (let i = 0; i < 160; i++) { const x = 18 + ((i * 137 + i * i * 31) % 1640); const y = 12 + ((i * 79 + i * i * 17) % 910); %>
        <g transform="translate(<%= x %> <%= y %>)"><g class="scene-star"><% if (i % 11 === 0) { %><path d="M0-9 1.8-1.8 9 0 1.8 1.8 0 9-1.8 1.8-9 0-1.8-1.8Z"/><% } else { %><circle r="<%= .9 + (i % 4) * .35 %>"/><% } %></g></g>
      <% } %>
    </g>
    <g class="woodland-moon">
      <circle cx="424" cy="186" r="115" fill="url(#moon-halo)"/>
      <circle cx="424" cy="186" r="50" fill="#c8c6b6"/>
      <path d="M433 137a50 50 0 0 0-42 86c49 7 78-47 42-86Z" fill="#f6efcf"/>
      <circle cx="405" cy="171" r="11" fill="#e4ddbb" opacity=".55"/>
      <circle cx="420" cy="202" r="6" fill="#e4ddbb" opacity=".6"/>
    </g>
    <g class="woodland-sun"><circle cx="424" cy="186" r="78" fill="#ffda7418"/><circle cx="424" cy="186" r="50" fill="#f4c660"/></g>
    <% if (isDriveScene) { %>
    <g class="library-clouds" fill="#e5eef0">
      <% for (const [x,y,scale] of [[-65,205,1.1],[385,115,.75],[585,175,.65],[770,94,.8]]) { %>
      <g transform="translate(<%= x %> <%= y %>) scale(<%= scale %>)"><path class="library-cloud" d="M0 54c-8-16 8-30 25-26C29 0 65-8 81 16c20-16 45-2 44 20 21-6 35 5 35 18Z"/></g>
      <% } %>
    </g>
    <% } %>
    <g class="woodland-trees">
      <g class="woodland-tree-back" transform="translate(-155 280) scale(1.3)"><use href="#woodland-trunk" width="420" height="720"/><use href="#woodland-canopy" x="35" y="110" width="440" height="300"/></g>
      <g class="woodland-tree-left" transform="translate(-285 70) scale(1.45)"><use href="#woodland-trunk" width="420" height="720"/><use href="#woodland-canopy" width="440" height="300"/><use href="#woodland-canopy" x="-65" y="90" width="350" height="240"/></g>
      <g class="woodland-tree-right" transform="<%= isDriveScene ? 'translate(810 -280) scale(2.65)' : 'translate(1130 -80) scale(1.9)' %>"><use href="#woodland-trunk" width="420" height="720"/><use href="#woodland-canopy" width="440" height="300"/><use href="#woodland-canopy" x="65" y="115" width="300" height="210"/></g>
    </g>
    <g class="woodland-ground">
      <% for (const [x,y,w] of [[-130,670,480],[170,755,420],[420,860,400],[745,865,400],[895,760,400],[1090,660,490],[1380,650,480]]) { %>
        <use href="#woodland-canopy" x="<%= x %>" y="<%= y %>" width="<%= w %>" height="<%= w * .7 %>"/>
      <% } %>
    </g>
    <g class="woodland-leaves woodland-leaves-back">
      <g class="woodland-frond"><image href="/leaves.svg" x="-95" y="510" width="340" height="500" transform="rotate(-20 75 900)"/></g>
      <g class="woodland-frond"><image href="/leaves.svg" x="95" y="670" width="350" height="470" transform="rotate(30 270 940)"/></g>
      <g class="woodland-frond"><image href="/leaves.svg" x="1330" y="610" width="370" height="490" transform="rotate(-20 1515 940)"/></g>
    </g>
    <% if (!isDriveScene) { %><%- include("woodland-perch", { isDriveScene }) %><% } %>
    <g class="woodland-leaves">
      <g class="woodland-frond"><image href="/leaves.svg" x="-45" y="605" width="280" height="420"/></g>
      <g class="woodland-frond"><image href="/leaves.svg" x="145" y="725" width="340" height="430" transform="rotate(45 315 950)"/></g>
      <g class="woodland-frond"><image href="/leaves.svg" x="315" y="790" width="250" height="350" transform="rotate(75 440 970)"/></g>
      <g class="woodland-frond"><image href="/leaves.svg" x="990" y="755" width="260" height="410" transform="rotate(-55 1120 970)"/></g>
      <g class="woodland-frond"><image href="/leaves.svg" x="1415" y="675" width="300" height="440" transform="rotate(-30 1565 960)"/></g>
    </g>
    <% if (isDriveScene) { %>
    <%- include("woodland-perch", { isDriveScene }) %>
    <g class="library-wind" fill="#92b577">
      <% for (const [x,y] of [[165,165],[115,345],[880,365],[1510,225],[80,525],[1350,490]]) { %>
      <g transform="translate(<%= x %> <%= y %>)"><g class="wind-leaf"><path d="M0 0Q-9-27 22-39Q29-12 0 0Z"/><path d="m0 0 16-29" stroke="#d5e6bb" stroke-width="1"/></g></g>
      <% } %>
    </g>
    <% } %>
    <g class="woodland-fireflies">
      <% for (const point of [[79,645],[88,584],[134,841],[272,867],[295,776],[389,709],[566,884],[998,861],[1199,855],[1430,482],[1550,802],[1369,254]]) { %>
        <g class="woodland-firefly" transform="translate(<%= point[0] %> <%= point[1] %>)"><circle r="27" fill="url(#firefly-glow)"/><circle r="4" fill="#fff8bf"/></g>
      <% } %>
    </g>
  </svg>
</div>
