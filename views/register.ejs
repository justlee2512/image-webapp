<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Tạo tài khoản · Richard Le Image Drive</title>
  <link rel="stylesheet" href="/assets/styles.css?v=<%= assetVersion %>">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-brand" aria-label="Giới thiệu">
      <div class="brand-mark" aria-hidden="true">RL</div>
      <p class="eyebrow">PRIVATE IMAGE DRIVE</p>
      <h1>Tạo không gian ảnh<br>của riêng bạn.</h1>
      <p>Mỗi tài khoản có thư viện độc lập, có thể tạo folder và chia sẻ folder chỉ đọc cho người dùng khác.</p>
      <div class="security-pills"><span>Tối đa <%= maxAccounts %> tài khoản</span><span>Chống giả mạo request</span></div>
    </section>

    <section class="auth-card">
      <div>
        <p class="eyebrow">BẮT ĐẦU</p>
        <h2>Tạo tài khoản</h2>
        <p class="muted">Mật khẩu tối thiểu 10 ký tự và dùng ít nhất 3 nhóm ký tự.</p>
      </div>

      <% if (error) { %><div class="alert alert-error" role="alert"><%= error %></div><% } %>

      <form method="post" action="/register" class="stack-form" data-busy-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          <span>Tên tài khoản</span>
          <input name="username" value="<%= form.username || '' %>" autocomplete="username" required minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+">
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" value="<%= form.email || '' %>" autocomplete="email" required maxlength="255">
        </label>
        <label>
          <span>Mật khẩu</span>
          <div class="password-field">
            <input id="register-password" type="password" name="password" autocomplete="new-password" required minlength="10" maxlength="128">
            <button type="button" class="icon-button password-toggle" data-password-target="register-password" aria-label="Hiện mật khẩu">Hiện</button>
          </div>
          <meter class="password-meter" min="0" max="4" value="0" data-password-meter="register-password"></meter>
        </label>
        <label>
          <span>Nhập lại mật khẩu</span>
          <input type="password" name="passwordConfirm" autocomplete="new-password" required minlength="10" maxlength="128">
        </label>
        <button class="button button-primary button-large" type="submit">Tạo tài khoản</button>
      </form>
      <p class="auth-switch">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
    </section>
  </main>
  <script src="/assets/auth.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
