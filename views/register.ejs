<!doctype html>
<html lang="vi">
<head>
  <script src="/theme.js?<%= assetVersion %>"></script>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Tạo tài khoản · Richard Le Drive</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/styles.css?<%= assetVersion %>"><script src="/auth.js?<%= assetVersion %>" defer></script>
</head>
<body class="auth-page">
  <header class="auth-header"><a class="brand" href="/"><span class="brand-mark">R</span><span>Richard Le <span class="brand-suffix">Drive</span></span></a><%- include("partials/theme-toggle") %></header>
  <main class="auth-shell">
    <section class="auth-panel">
      <form class="auth-card" method="post" action="/register">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2>Tạo tài khoản</h2><p class="muted">Tài khoản sẽ sử dụng được sau khi admin chấp thuận.</p>
        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert success"><%= success %></div><% } %>
        <label>Tên tài khoản<input name="username" value="<%= form.username || '' %>" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+" required placeholder="nguyen_an"></label>
        <label>Email<input type="email" name="email" value="<%= form.email || '' %>" autocomplete="email" required placeholder="ban@example.com"></label>
        <label>Mật khẩu<div class="password-field"><input id="register-password" type="password" name="password" minlength="8" autocomplete="new-password" required placeholder="Tối thiểu 8 ký tự"><button class="password-toggle" type="button" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false">Hiện</button></div></label>
        <label>Nhập lại mật khẩu<div class="password-field"><input id="register-password-confirm" type="password" name="passwordConfirm" minlength="8" autocomplete="new-password" required placeholder="Nhập lại mật khẩu"></div><small class="password-match" id="password-match" aria-live="polite"></small></label>
        <button class="button primary wide" type="submit">Gửi yêu cầu <span>→</span></button>
        <p class="switch">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
      </form>
    </section>
  </main>
</body></html>
