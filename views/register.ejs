<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <meta name="asset-version" content="<%= assetVersion %>">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Tạo tài khoản · Richard Le Drive</title>
  <link rel="stylesheet" href="/assets/styles.css?v=<%= assetVersion %>">
  <script src="/assets/toast.js?v=<%= assetVersion %>" defer></script>
  <script src="/assets/auth.js?v=<%= assetVersion %>" defer></script>
</head>
<body class="auth-page">
  <div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="false"></div>
  <main class="auth-shell">
    <section class="auth-story register-story">
      <div class="marquee-banner compact" aria-label="Thông báo"><span>✨ Tạo tài khoản để lưu trữ ảnh riêng tư · Giao diện hiện đại · Dễ dùng</span></div>
      <div class="intro-popups auth-intro" aria-label="Thông tin giới thiệu">
        <div class="intro-popup"><div class="intro-track"><span>🌿 Bắt đầu hành trình lưu giữ khoảnh khắc với một không gian thư viện đẹp mắt</span></div></div>
        <div class="intro-popup"><div class="intro-track"><span>🛡️ Bảo vệ ảnh của bạn bằng tài khoản riêng và trải nghiệm mượt mà mỗi lần mở</span></div></div>
      </div>
      <a class="brand brand-light" href="/"><span class="brand-mark">R</span><span>Richard Le</span></a>
      <div><p class="eyebrow">THƯ VIỆN CÁ NHÂN</p><h1>Ảnh của bạn.<br>Không gian của bạn.</h1><p class="story-copy">Bắt đầu xây dựng bộ sưu tập riêng, được bảo vệ bằng tài khoản của chính bạn.</p></div>
      <p class="story-foot">Chỉ dành cho <%= maxAccounts %> thành viên đầu tiên</p>
    </section>
    <section class="auth-panel">
      <form class="auth-card" method="post" action="/register" data-ajax-form data-success-redirect="/drive">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="mobile-brand"><span class="brand-mark">R</span> Richard Le</div>
        <p class="eyebrow ink">BẮT ĐẦU NGAY</p><h2>Tạo tài khoản</h2><p class="muted">Hệ thống giới hạn tối đa <%= maxAccounts %> tài khoản.</p>
        <% if (error) { %><div hidden data-toast-message="<%= error %>" data-toast-type="error"></div><% } %>
        <label>Tên tài khoản<input name="username" value="<%= form.username || '' %>" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+" autocomplete="username" required placeholder="nguyen_an"></label>
        <label>Email<input type="email" name="email" value="<%= form.email || '' %>" autocomplete="email" required maxlength="255" placeholder="ban@example.com"></label>
        <label>Mật khẩu<div class="password-field"><input id="register-password" type="password" name="password" minlength="10" maxlength="128" autocomplete="new-password" required placeholder="Tối thiểu 10 ký tự"><button class="password-toggle" type="button" data-password-target="register-password" aria-label="Hiện mật khẩu">Hiện</button></div></label>
        <label>Nhập lại mật khẩu<div class="password-field"><input id="register-password-confirm" type="password" name="passwordConfirm" minlength="10" maxlength="128" autocomplete="new-password" required placeholder="Nhập lại mật khẩu"></div><small class="password-match" id="password-match" aria-live="polite"></small></label>
        <button class="button primary wide" type="submit">Tạo tài khoản <span>→</span></button>
        <p class="switch">Đã có tài khoản? <a href="/login">Đăng nhập</a></p>
      </form>
    </section>
  </main>
</body>
</html>
