<!doctype html>
<html lang="vi">
<head>
  <script src="/theme.js?<%= assetVersion %>"></script>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Quản trị tài khoản · Richard Le Drive</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/styles.css?<%= assetVersion %>">
  <script src="/session-expiry.js?<%= assetVersion %>" defer></script>
</head>
<body class="auth-page">
  <%- include("partials/scene") %>
  <div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="true"></div>
  <header class="auth-header"><a class="brand" href="/drive"><span class="brand-mark">R</span><span>Richard Le</span></a><%- include("partials/theme-toggle") %></header>
  <main class="auth-shell admin-shell">
    <section class="auth-panel">
      <div class="auth-card admin-card">
        <p class="eyebrow ink">QUẢN TRỊ</p>
        <h2>Quản lý tài khoản</h2>
        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert success"><%= success %></div><% } %>

        <div class="user-list">
          <h3>Yêu cầu đăng ký chờ duyệt (<%= accountRequests.length %>)</h3>
          <% if (!accountRequests.length) { %><p class="muted">Không có yêu cầu nào đang chờ.</p><% } %>
          <% accountRequests.forEach((request) => { %>
            <div class="user-row">
              <div><strong><%= request.username %></strong><small><%= request.email %></small></div>
              <div class="user-actions">
                <form method="post" action="/admin/account-requests/<%= request.id %>/approve">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="button primary" type="submit">Chấp thuận</button>
                </form>
                <form method="post" action="/admin/account-requests/<%= request.id %>/reject" onsubmit="return confirm('Từ chối yêu cầu đăng ký này?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="button danger" type="submit">Từ chối</button>
                </form>
              </div>
            </div>
          <% }) %>
        </div>

        <form class="admin-form" method="post" action="/admin/users" data-ajax-form="true">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <h3>Tạo tài khoản mới</h3>
          <label>Tên tài khoản<input name="username" required placeholder="newuser"></label>
          <label>Email<input type="email" name="email" required placeholder="newuser@example.com"></label>
          <label>Mật khẩu<input type="password" name="password" required placeholder="Tối thiểu 8 ký tự"></label>
          <label>Nhập lại mật khẩu<input type="password" name="passwordConfirm" required placeholder="Nhập lại mật khẩu"></label>
          <button class="button primary wide" type="submit">Tạo tài khoản</button>
        </form>

        <section class="user-list account-list" aria-labelledby="account-list-title">
          <div class="admin-section-heading">
            <div>
              <p class="section-kicker">Tài khoản</p>
              <h3 id="account-list-title">Danh sách người dùng</h3>
            </div>
            <span class="count-badge"><%= users.length %> người dùng</span>
          </div>

          <div class="account-rows">
            <% users.forEach((account) => { %>
              <% const isCurrentAccount = Number(account.id) === Number(user.id); %>
              <article class="user-row account-row">
                <div class="user-identity">
                  <span class="user-avatar" aria-hidden="true"><%= account.username.charAt(0).toUpperCase() %></span>
                  <div class="user-copy">
                    <div class="user-name-line">
                      <strong><%= account.username %></strong>
                      <% if (isCurrentAccount) { %><span class="current-badge">Bạn</span><% } %>
                    </div>
                    <small title="<%= account.email %>"><%= account.email %></small>
                  </div>
                </div>

                <div class="user-actions">
                  <form class="password-reset-form" method="post" action="/admin/users/<%= account.id %>/reset-password">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="sr-only" for="new-password-<%= account.id %>">Mật khẩu mới cho <%= account.username %></label>
                    <input id="new-password-<%= account.id %>" type="password" name="newPassword" placeholder="Mật khẩu mới" autocomplete="new-password" minlength="8" required>
                    <label class="sr-only" for="confirm-password-<%= account.id %>">Nhập lại mật khẩu mới cho <%= account.username %></label>
                    <input id="confirm-password-<%= account.id %>" type="password" name="newPasswordConfirm" placeholder="Nhập lại mật khẩu" autocomplete="new-password" minlength="8" required>
                    <button class="button outline password-button" type="submit">
                      <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2 13.6 9.4"/><circle cx="7.5" cy="15.5" r="5.5"/><path d="m15 6 3 3m-6 3 3 3"/></svg>
                      <span>Đổi mật khẩu</span>
                    </button>
                  </form>

                  <% if (!isCurrentAccount) { %>
                    <form class="user-delete-form" method="post" action="/admin/users/<%= account.id %>/delete" onsubmit="return confirm('Xóa tài khoản <%= account.username %>? Hành động này không thể hoàn tác.')">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="button danger" type="submit" aria-label="Xóa tài khoản <%= account.username %>">
                        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14M10 11v5m4-5v5"/></svg>
                        <span>Xóa</span>
                      </button>
                    </form>
                  <% } %>
                </div>
              </article>
            <% }) %>
          </div>
        </section>

        <p class="switch"><a href="/drive">Quay về thư viện</a></p>
      </div>
    </section>
  </main>
</body>
</html>
