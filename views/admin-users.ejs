<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>Quản trị tài khoản · Richard Le Drive</title>
  <link rel="stylesheet" href="/assets/styles.css?v=<%= assetVersion %>">
  <script src="/assets/auth.js?v=<%= assetVersion %>" defer></script>
</head>
<body class="auth-page">
  <div class="toast-stack" id="toast-stack" aria-live="polite" aria-atomic="true"></div>
  <main class="auth-shell admin-shell">
    <section class="auth-panel">
      <div class="auth-card admin-card">
        <div class="mobile-brand"><span class="brand-mark">R</span> Richard Le</div>
        <p class="eyebrow ink">QUẢN TRỊ</p>
        <h2>Quản lý tài khoản</h2>
        <p class="muted">Admin có thể tạo tài khoản mới, xóa người dùng và đổi mật khẩu.</p>
        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <% if (success) { %><div class="alert success"><%= success %></div><% } %>

        <form class="admin-form" method="post" action="/admin/users" data-busy-form>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <h3>Tạo tài khoản mới</h3>
          <label>Tên tài khoản<input name="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]+" required placeholder="newuser"></label>
          <label>Email<input type="email" name="email" maxlength="255" required placeholder="newuser@example.com"></label>
          <label>Mật khẩu<input type="password" name="password" minlength="10" maxlength="128" autocomplete="new-password" required placeholder="Tối thiểu 10 ký tự"></label>
          <label>Nhập lại mật khẩu<input type="password" name="passwordConfirm" minlength="10" maxlength="128" autocomplete="new-password" required placeholder="Nhập lại mật khẩu"></label>
          <button class="button primary wide" type="submit">Tạo tài khoản</button>
        </form>

        <div class="user-list">
          <h3>Danh sách người dùng</h3>
          <% users.forEach((account) => { %>
            <div class="user-row <%= account.is_admin ? 'is-admin' : '' %>">
              <div>
                <strong><%= account.username %></strong>
                <% if (String(account.id) === String(user.id)) { %><span class="badge">Bạn</span><% } %>
                <% if (account.is_admin) { %><span class="badge admin">Admin</span><% } %>
                <small><%= account.email %></small>
              </div>
              <div class="user-actions">
                <form method="post" action="/admin/users/<%= account.id %>/reset-password" data-busy-form>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="password" name="newPassword" minlength="10" maxlength="128" placeholder="Mật khẩu mới" required>
                  <input type="password" name="newPasswordConfirm" minlength="10" maxlength="128" placeholder="Nhập lại" required>
                  <button class="button outline" type="submit">Đổi mật khẩu</button>
                </form>
                <% if (String(account.id) !== String(user.id)) { %>
                  <form method="post" action="/admin/users/<%= account.id %>/delete" data-confirm="Xóa tài khoản này?">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="button danger" type="submit">Xóa</button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
        <p class="switch"><a href="/drive">Quay về thư viện</a></p>
      </div>
    </section>
  </main>
</body>
</html>
