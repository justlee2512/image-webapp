<!doctype html>
<html lang="vi">
<head>
  <script src="/theme.js?<%= assetVersion %>"></script>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Đăng nhập · Richard Le Drive</title><link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="stylesheet" href="/styles.css?<%= assetVersion %>"><script src="/login.js?<%= assetVersion %>" defer></script>
</head>
<body class="auth-page botanical-page">
  <%- include("partials/scene") %>
  <header class="auth-header"><a class="brand" href="/"><span class="brand-mark">R</span><span>Richard Le <span class="brand-suffix">Drive</span></span></a><%- include("partials/theme-toggle") %></header>
  <main class="auth-shell">
    <section class="auth-panel">
      <form class="auth-card" id="login-form" method="post" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h2>Đăng nhập</h2>
        <% if (error) { %><div class="alert error"><%= error %></div><% } %>
        <label>Tên tài khoản hoặc email<input name="identity" value="<%= form.identity || '' %>" autocomplete="username" autofocus required placeholder="ban@example.com"></label>
        <label>Mật khẩu<input type="password" name="password" autocomplete="current-password" required placeholder="••••••••"></label>
        <button class="button primary wide" type="submit">Đăng nhập <span>→</span></button>
        <p class="switch">Chưa có tài khoản? <a href="/register">Tạo tài khoản</a></p>
      </form>
    </section>
  </main>
</body></html>
