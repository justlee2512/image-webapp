<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Đăng nhập · Richard Le Image Drive</title>
  <link rel="stylesheet" href="/assets/styles.css?v=<%= assetVersion %>">
</head>
<body class="auth-page">
  <main class="auth-shell">
    <section class="auth-brand" aria-label="Giới thiệu">
      <div class="brand-mark" aria-hidden="true">RL</div>
      <p class="eyebrow">PRIVATE IMAGE DRIVE</p>
      <h1>Lưu ảnh riêng tư.<br>Truy cập nhanh chóng.</h1>
      <p>Thư viện ảnh cá nhân chạy trên PostgreSQL, tối ưu cho desktop, điện thoại và nhiều replica Kubernetes.</p>
      <div class="security-pills" aria-label="Tính năng bảo mật">
        <span>Session bảo mật</span><span>Ảnh riêng tư</span><span>HTTPS-ready</span>
      </div>
    </section>

    <section class="auth-card">
      <div>
        <p class="eyebrow">CHÀO MỪNG TRỞ LẠI</p>
        <h2>Đăng nhập</h2>
        <p class="muted">Dùng tên tài khoản hoặc email của bạn.</p>
      </div>

      <% if (error) { %>
        <div class="alert alert-error" role="alert"><%= error %></div>
      <% } %>

      <form method="post" action="/login" class="stack-form" data-busy-form>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label>
          <span>Tài khoản hoặc email</span>
          <input name="identity" value="<%= form.identity || '' %>" autocomplete="username" required autofocus maxlength="255">
        </label>
        <label>
          <span>Mật khẩu</span>
          <div class="password-field">
            <input id="login-password" type="password" name="password" autocomplete="current-password" required maxlength="128">
            <button type="button" class="icon-button password-toggle" data-password-target="login-password" aria-label="Hiện mật khẩu">Hiện</button>
          </div>
        </label>
        <button class="button button-primary button-large" type="submit">Đăng nhập</button>
      </form>

      <p class="auth-switch">Chưa có tài khoản? <a href="/register">Tạo tài khoản</a></p>
    </section>
  </main>
  <script src="/assets/auth.js?v=<%= assetVersion %>" defer></script>
</body>
</html>
